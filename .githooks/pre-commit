#!/bin/sh
# Rebuild dist/*.skill and dist/*.zip whenever a commit touches skills/, atoms/,
# or src/ — an atom or src edit needs recompiling into every
# skills/*/SKILL.md that uses it, not just the file that was actually edited —
# and stage the rebuilt files into the same commit. See dist/README.md.
if git diff --cached --name-only | grep -qE '^(skills|atoms|src)/'; then
	make build && git add skills/ atoms/ dist/
fi
