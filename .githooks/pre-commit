#!/bin/sh
# Rebuild dist/*.skill and dist/*.zip whenever a commit touches skills/, atoms/,
# or src/ — an atom or src edit needs recompiling into every
# skills/*/SKILL.md that uses it, not just the file that was actually edited —
# and stage the rebuilt files into the same commit. See dist/README.md.
#
# atoms/*/SKILL.md is gitignored (a dev-only test artifact, never shipped),
# so it can't be staged and never appears in the staleness check below —
# only skills/*/SKILL.md, the shipped output, needs the hand-edit guard.
if git diff --cached --name-only | grep -qE '^(skills|atoms|src)/'; then
	# A skills/<name>/SKILL.md can go stale two ways: its own src/*.hbs.md
	# changed, or an atoms/*/CONTENT.md it composes changed — both expected,
	# and both fixed by the rebuild below. A hand-edit is different: someone
	# opened the generated file itself and staged that edit. Neither src nor
	# atoms changing ever touches skills/*/SKILL.md on disk by itself, so the
	# reliable hand-edit signal is whether the generated file itself is in
	# the staged set — not whether its source template is. Catch that case
	# here and fail loud before `make build` silently overwrites it. The stop
	# applies to a skill compiled from a template; see the branch below for
	# the hand-written path, where the file is its own source.
	staged=$(git diff --cached --name-only)
	stale=$(node scripts/compile.mjs --check 2>&1 | grep '^stale: ' | sed 's/^stale: //')
	for generated in $stale; do
		case "$generated" in
			skills/*/SKILL.md) ;;
			*) continue ;;
		esac
		if echo "$staged" | grep -qx "$generated"; then
			source="src/$(echo "$generated" | cut -d/ -f2).hbs.md"
			# Only a skill that HAS a template is generated end to end, so a
			# staged edit to it is a hand-edit the rebuild would overwrite. A
			# hand-written skill is its own source everywhere except the
			# appended Voice section, which compile.mjs refuses to rewrite when
			# it holds anything the compiler did not write. Staleness there says
			# the atom moved ahead of the file, and the rebuild below refreshes
			# it without touching the staged prose, so it is a note, not a stop.
			if [ -f "$source" ]; then
				echo "error: $generated doesn't match what compiling $source (and the atoms/ it composes) produces." >&2
				echo "It looks like $generated was hand-edited directly — edit $source or the relevant atoms/*/CONTENT.md instead, then run \`make compile\`." >&2
				exit 1
			fi
			echo "note: $generated carries an older render of the voice atom; the rebuild below refreshes it." >&2
		fi
	done
	make build && git add skills/ dist/
fi
