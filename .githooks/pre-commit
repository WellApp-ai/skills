#!/bin/sh
# Rebuild dist/*.skill and dist/*.zip whenever a commit touches skills/, atoms/,
# or src/ — an atom or src edit needs recompiling into every
# skills/*/SKILL.md that uses it, not just the file that was actually edited —
# and stage the rebuilt files into the same commit. See dist/README.md.
#
# atoms/*/SKILL.md is gitignored (a dev-only test artifact, never shipped),
# so it can't be staged and never appears in the staleness check below —
# only skills/*/SKILL.md, the shipped output, needs the hand-edit guard.
if git diff --cached --name-only | grep -qE '^(skills|atoms|src)/'; then
	# A skills/<name>/SKILL.md compiled from a src/*.hbs.md source that this
	# commit doesn't touch can only be stale because someone hand-edited the
	# generated file directly — `make build` below would silently overwrite
	# that edit and stage the overwrite. Catch it here and fail loud instead,
	# before anything is lost.
	staged=$(git diff --cached --name-only)
	stale=$(node scripts/compile.mjs --check 2>&1 | grep '^stale: ' | sed 's/^stale: //')
	for generated in $stale; do
		case "$generated" in
			skills/*/SKILL.md)
				source="src/$(echo "$generated" | cut -d/ -f2).hbs.md" ;;
			*) continue ;;
		esac
		if ! echo "$staged" | grep -qx "$source"; then
			echo "error: $generated is generated from $source, which this commit doesn't touch." >&2
			echo "It looks like $generated was hand-edited directly — edit $source instead, then run \`make compile\`." >&2
			exit 1
		fi
	done
	make build && git add skills/ dist/
fi
